@page "/"

<PageTitle>The Arcane Portal</PageTitle>

<section class="hero-section">
    <h1 class="hero-title">⚔ The Arcane Portal</h1>
    <p class="hero-lore">
        Three ancient workflows await your command. Speak your intent, and the AI agents
        shall weave words of wonder, danger, and destiny.
    </p>
</section>

<div class="rune-divider">᛭ ᛭ ᛭ ᛭ ᛭</div>

<div class="workflow-cards">
    <a href="/world-builder" class="workflow-card">
        <div class="scroll-panel">
            <span class="workflow-card-icon">🌍</span>
            <h3>World Builder</h3>
            <p>Three masters craft a world in sequence — first the landscape, then a character, then a twist of fate.</p>
            <div class="card-badge-row">
                <span class="agent-chip">🏔 World_Builder</span>
                <span class="agent-chip">🧙 Character_Creator</span>
                <span class="agent-chip">⚡ Plot_Generator</span>
            </div>
        </div>
    </a>

    <a href="/party-chat" class="workflow-card">
        <div class="scroll-panel">
            <span class="workflow-card-icon">⚔️</span>
            <h3>Party Council</h3>
            <p>Aragorn, Lila, and Zoltan debate your dilemma in turn — wisdom, wit, and arcane insight combined.</p>
            <div class="card-badge-row">
                <span class="agent-chip">⚔️ Aragorn</span>
                <span class="agent-chip">🗡️ Lila</span>
                <span class="agent-chip">🔮 Zoltan</span>
            </div>
        </div>
    </a>

    <a href="/story-writers" class="workflow-card">
        <div class="scroll-panel">
            <span class="workflow-card-icon">📚</span>
            <h3>Story Conclave</h3>
            <p>Three genre masters write simultaneously — horror, fantasy, and science fiction respond at once.</p>
            <div class="card-badge-row">
                <span class="agent-chip">📖 Fantasy_Expert</span>
                <span class="agent-chip">💀 Horror_Expert</span>
                <span class="agent-chip">🚀 SciFi_Expert</span>
            </div>
        </div>
    </a>
</div>
